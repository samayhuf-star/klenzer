{
  "expo": {
    "name": "Ai Klenzer",
    "slug": "klenzer",
    "scheme": "klenzer",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F8FC",
    "ios": {
      "bundleIdentifier": "com.krosz.klenzer",
      "buildNumber": "30",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "photos-redirect"
        ],
        "NSLocationWhenInUseUsageDescription": "Ai Klenzer copies a Live Photo’s existing location onto the still photo when you convert it. The location stays on your device.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.krosz.klenzer",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1020"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ai Klenzer reads your photo library on-device to find duplicates, screenshots, Live Photos and large videos, to convert a Live Photo to a still when you ask, and to move photos you pick into Secret Album. Nothing is uploaded, and nothing is deleted until you confirm.",
          "savePhotosPermission": "Ai Klenzer saves a still photo when you convert a Live Photo, and saves a photo back to your library when you export it from Secret Album. Nothing is uploaded.",
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Ai Klenzer finds and merges duplicate contacts on your device. Contacts never leave your phone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ai Klenzer uses Face ID to unlock your Secret Album. Face data stays with iOS and is never shared with Ai Klenzer."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Ai Klenzer uses Face ID to unlock your Secret Album. Face data stays with iOS and is never shared with Ai Klenzer."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ai Klenzer reads your photo library on-device to find duplicates, screenshots, Live Photos and large videos, to convert a Live Photo to a still when you ask, and to move photos you pick into Secret Album. Nothing is uploaded, and nothing is deleted until you confirm.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6034b7f-62d6-487e-aff1-f013636ae0b5"
      },
      "privacyPolicyUrl": "https://klenzer.online/klenzer-app/privacy/",
      "oneSignalAppId": "6849a926-8ea6-4413-8531-b6fab30ce812"
    },
    "owner": "krosz",
    "description": "Klenzer is a private, on-device photo clutter cleaner. It finds duplicate photos, screenshots and large videos, and deletes only what you choose."
  }
}
